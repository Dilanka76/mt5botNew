# Per-account secrets. Copy this file to .env.<account> for each account you
# run, using the CLEAN account name (this is also the --account value, and
# the name used for config/settings.<account>.yaml, logs/<account>/, and
# KILL_SWITCH_<account> — always exactly one of these, no extra letters,
# no spaces):
#   cp .env.demo1.example .env.demo1
#   cp .env.demo1.example .env.demo2
#   cp .env.demo1.example .env.live1
#   cp .env.demo1.example .env.live2
#   cp .env.demo1.example .env.live3
# and fill in real values. .env.* files are gitignored — never commit real
# credentials.
#
# MT5_LOGIN/MT5_PASSWORD/MT5_SERVER are OPTIONAL: if the MT5_TERMINAL_PATH
# instance below is already running and logged into this account, the bot
# just attaches to it without logging in again. Set them if you want the
# bot to launch/log in to MT5 itself (e.g. after a server reboot).

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=BlackBullMarkets-Demo

# Each account runs against its OWN MT5 terminal installation/instance (a
# separate install directory, not just a separate profile) so that all 5
# accounts can be logged in and trading simultaneously without one terminal
# window's account switch logging another one out.
#
# IMPORTANT: this path is INDEPENDENT of the clean --account name above —
# it is never derived from it, and the two are allowed to look different.
# The actual terminal folders on disk carry a letter suffix purely to make
# them visually distinguishable in File Explorer; copy the exact path for
# THIS account's folder here, unchanged:
#   demo1 -> C:\MT5BOTSCRIPT\MT5-Demo1 T\terminal64.exe
#   demo2 -> C:\MT5BOTSCRIPT\MT5-Demo2 D\terminal64.exe
#   live1 -> C:\MT5BOTSCRIPT\MT5-Live1 T\terminal64.exe
#   live2 -> C:\MT5BOTSCRIPT\MT5-Live2 D\terminal64.exe
#   live3 -> C:\MT5BOTSCRIPT\MT5-Live3 C\terminal64.exe
MT5_TERMINAL_PATH=

# NOT used by api_server.py anymore — the unified gateway now uses ONE
# shared master key from .env.gateway (see .env.gateway.example) instead
# of a separate key per account. Leave this blank/unused unless something
# else in the future needs a per-account key.
API_KEY=