# Copy this file to .env and fill in real values. .env is gitignored.
#
# These are OPTIONAL. If MT5 is already running and logged into the demo
# account on this machine (as it is on the EC2 server right now), the bot
# can just attach to that running terminal without logging in again.
# Set these only if you want the bot to launch/login MT5 itself
# (e.g. after a server reboot).

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial14
MT5_TERMINAL_PATH=
